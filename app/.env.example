# Optional LM Studio OpenAI-compatible API. No key is required.
LOREMASTER_LM_STUDIO_URL=http://127.0.0.1:1234/v1
# Leave blank to use the first model currently loaded in LM Studio.
LOREMASTER_LM_STUDIO_MODEL=
# Maximum local inference time; availability checks have their own short timeout.
LOREMASTER_LM_STUDIO_TIMEOUT_MS=90000
# Optional model-list/status request timeout.
LOREMASTER_LM_STUDIO_STATUS_TIMEOUT_MS=2200

# Optional: change the Vite host only when intentionally sharing on a trusted LAN.
# Keep the default loopback binding for normal single-PC use.
# LOREMASTER_HOST=0.0.0.0
